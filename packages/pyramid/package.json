{
  "name": "@qa-guru/allure-notifications-pyramid",
  "version": "6.2.0",
  "description": "Testing-pyramid palette + rounded-tier geometry SSOT (Phase 2).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./browser": {
      "types": "./dist/src/browser.d.ts",
      "import": "./dist/src/browser.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qa-guru/allure-notifications.git",
    "directory": "packages/pyramid"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
