    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@qa-guru/allure-notifications-test-meta": "workspace:*",
    "@types/node": "26.1.2",
