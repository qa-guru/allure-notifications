{
  "name": "@qa-guru/allure-notifications",
  "version": "6.2.1",
  "description": "CLI: allure-notifications send --config (6.0 TypeScript). Collage via @napi-rs/canvas.",
  "type": "module",
  "bin": {
    "allure-notifications": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qa-guru/allure-notifications.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/qa-guru/allure-notifications#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node ../../scripts/node-test-allure.mjs dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@qa-guru/allure-notifications-config": "workspace:*",
    "@qa-guru/allure-notifications-core": "workspace:*",
    "undici": "^8.0.0"
  },
  "devDependencies": {
    "@qa-guru/allure-notifications-test-meta": "workspace:*",
    "@types/node": "26.1.2",
    "allure-node-test": "3.10.2",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
