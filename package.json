{
  "name": "@allure-notifications/monorepo",
  "version": "6.0.11",
  "private": true,
  "description": "Allure report \u2192 messenger notifications. 6.0.* = TypeScript monorepo (CLI + builder). 5.0.* = Java jar under legacy/java (freeze 5.0.8); there is no 5.1 line.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "node scripts/run-tests.mjs",
    "coverage": "node scripts/run-coverage.mjs",
    "allure:generate": "rm -rf allure-report && allure generate allure-results --output allure-report",
    "panel-gallery": "node scripts/panel-gallery.mjs",
    "widget-picker": "node scripts/panel-gallery.mjs",
    "publish:packages": "pnpm --filter @allure-notifications/config --filter @allure-notifications/pyramid --filter @allure-notifications/core --filter allure-notifications --filter @allure-notifications/plugin publish --access public --no-git-checks",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "allure": "^3.14.3",
    "allure-js-commons": "3.10.2",
    "allure-node-test": "3.10.2",
    "allure-notifications": "workspace:*",
    "allure-playwright": "3.10.2",
    "c8": "^10.1.3",
    "happy-dom": "^20.11.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "typescript": "7.0.2",
    "v8-to-istanbul": "^9.3.0"
  },
  "changelog": {
    "labels": {
      "other": "New Feature",
      "fix": "Bug Fix",
      "refactor": "Refactoring"
    },
    "repo": "qa-guru/allure-notifications"
  }
}
