{
  "name": "@qa-guru/allure-notifications-builder",
  "private": true,
  "type": "module",
  "version": "6.2.2",
  "description": "Full config.json configurator for allure-notifications (apps/builder).",
  "scripts": {
    "sync-config": "node scripts/sync-config.mjs",
    "sync-kit-collage": "node scripts/sync-kit-collage.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "pnpm run build && pnpm run sync-config && pnpm run sync-kit-collage && pnpm run build:test",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node ../../scripts/node-test-allure.mjs dist/test/*.test.js",
    "test:e2e": "PLAYWRIGHT_HEADLESS=1 playwright test",
    "test:headed": "PW_HEADED=1 playwright test --headed",
    "test:ui": "playwright test --ui",
    "generate-sw": "node scripts/generate-sw.mjs"
  },
  "dependencies": {
    "@qa-guru/allure-notifications-config": "workspace:*",
    "@qa-guru/allure-report-kit": "^0.3.3"
  },
  "devDependencies": {
    "@qa-guru/allure-notifications-test-meta": "workspace:*",
    "@playwright/test": "^1.61.1",
    "allure-node-test": "3.10.2",
    "allure-playwright": "3.10.2",
    "typescript": "7.0.2",
    "@types/node": "26.1.2"
  }
}
