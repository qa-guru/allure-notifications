{
  "base": {
    "project": "allure-notifications",
    "environment": "CI",
    "comment": "Marketing · WD-1410 · 10 filled widgets",
    "language": "ru",
    "allureFolder": "../allure-report",
    "allureResultsFolder": "../allure-results",
    "enableChart": true,
    "darkMode": true,
    "chart": {
      "mode": "collage",
      "layout": "free",
      "width": 1410,
      "height": 1080,
      "headerHeight": 48,
      "cardGap": 12,
      "gridCols": 10,
      "gridRows": 10,
      "items": [
        { "type": "currentStatus", "x": 0, "y": 0, "w": 2, "h": 3 },
        { "type": "suites", "x": 2, "y": 0, "w": 3, "h": 3 },
        { "type": "testResultSeverities", "x": 5, "y": 0, "w": 2, "h": 3 },
        { "type": "testingPyramid", "x": 7, "y": 0, "w": 3, "h": 3 },
        { "type": "durations", "x": 0, "y": 3, "w": 2, "h": 3, "groupBy": "layer" },
        { "type": "durations", "x": 2, "y": 3, "w": 2, "h": 3 },
        { "type": "stabilityDistribution", "x": 4, "y": 3, "w": 2, "h": 3, "groupBy": "feature" },
        { "type": "stabilityDistribution", "x": 6, "y": 3, "w": 2, "h": 3, "groupBy": "epic" },
        { "type": "stabilityDistribution", "x": 8, "y": 3, "w": 2, "h": 3, "groupBy": "story" },
        { "type": "stabilityDistribution", "x": 0, "y": 6, "w": 10, "h": 3, "groupBy": "label-name:component" }
      ],
      "pyramidFallback": "none"
    }
  },
  "telegram": {
    "token": "",
    "chat": "",
    "topic": "",
    "replyTo": "",
    "templatePath": "/templates/telegram.ftl"
  }
}
