{
  "base": {
    "project": "reference-app",
    "environment": "ci / dense",
    "comment": "cb870-dense-live · all 7 live · pie 3×3 · pyramid|durations · severities 2×3 · dual durations",
    "allureFolder": "../build/pyramid-showcase/allure-report",
    "allureResultsFolder": "../build/pyramid-showcase/allure-results",
    "enableChart": true,
    "darkMode": true,
    "enableSuitesPublishing": false,
    "language": "ru",
    "chart": {
      "mode": "collage",
      "layout": "free",
      "width": 870,
      "height": 1080,
      "headerHeight": 56,
      "cardGap": 14,
      "tilePad": 6,
      "gridCols": 10,
      "gridRows": 10,
      "items": [
        {
          "type": "currentStatus",
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 3
        },
        {
          "type": "statusDynamics",
          "x": 3,
          "y": 0,
          "w": 5,
          "h": 3
        },
        {
          "type": "testResultSeverities",
          "x": 8,
          "y": 0,
          "w": 2,
          "h": 3
        },
        {
          "type": "testingPyramid",
          "x": 0,
          "y": 3,
          "w": 3,
          "h": 3
        },
        {
          "type": "durations",
          "x": 3,
          "y": 3,
          "w": 4,
          "h": 3,
          "groupBy": "layer"
        },
        {
          "type": "successRateDistribution",
          "x": 7,
          "y": 3,
          "w": 3,
          "h": 3
        },
        {
          "type": "durations",
          "x": 0,
          "y": 6,
          "w": 10,
          "h": 4
        }
      ],
      "pyramidFallback": "suites"
    },
    "links": {
      "report": "https://autotests-ai.github.io/reference-app/reports/latest/awesome/index.html",
      "dashboard": "https://autotests-ai.github.io/reference-app/reports/latest/dashboard/index.html",
      "testops": "https://allure.qa.guru",
      "build": "https://github.com/autotests-ai/reference-app/actions"
    }
  },
  "telegram": {
    "token": "0:preview-no-send",
    "chat": "0",
    "templatePath": "/templates/telegram.ftl"
  }
}
