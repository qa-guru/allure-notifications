{
  "base": {
    "project": "Multistack",
    "environment": "ci / mid",
    "comment": "Telegram default · cb870-mid-dynamics (narrow)",
    "allureFolder": "../build/pyramid-showcase/allure-report",
    "allureResultsFolder": "../build/pyramid-showcase/allure-results",
    "enableChart": true,
    "darkMode": true,
    "enableSuitesPublishing": false,
    "language": "ru",
    "chart": {
      "mode": "collage",
      "layout": "free",
      "width": 870,
      "height": 1080,
      "headerHeight": 31,
      "cardGap": 14,
      "tilePad": 6,
      "gridCols": 10,
      "gridRows": 10,
      "items": [
        {
          "type": "currentStatus",
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 4
        },
        {
          "type": "statusDynamics",
          "x": 4,
          "y": 0,
          "w": 6,
          "h": 4
        },
        {
          "type": "testingPyramid",
          "x": 0,
          "y": 4,
          "w": 4,
          "h": 3
        },
        {
          "type": "durations",
          "x": 4,
          "y": 4,
          "w": 6,
          "h": 3,
          "groupBy": "layer"
        },
        {
          "type": "successRateDistribution",
          "x": 0,
          "y": 7,
          "w": 7,
          "h": 3
        },
        {
          "type": "testResultSeverities",
          "x": 7,
          "y": 7,
          "w": 3,
          "h": 3
        }
      ],
      "pyramidFallback": "suites"
    },
    "links": {
      "report": "https://reports.autotests.ai/reports/latest/awesome/index.html",
      "dashboard": "https://reports.autotests.ai/reports/latest/dashboard/index.html",
      "testops": "https://allure.qa.guru",
      "build": "https://github.com/autotests-ai/autotests-ai-multistack-app/actions"
    }
  },
  "telegram": {
    "token": "0:preview-no-send",
    "chat": "0",
    "templatePath": "/templates/telegram.ftl"
  }
}
